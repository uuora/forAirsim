@@ -38,6 +43,7 @@ namespace airlib
 
             // Only Generic for now
             setupFrameGenericQuad(params);
+            applyDynamicsProfile(params);
         }
 
         virtual const SensorFactory* getSensorFactory() const override
@@ -46,6 +52,96 @@ namespace airlib
         }
 
     private:
+        void applyDynamicsProfile(Params& params) const
+        {
+            params.dynamics_profile_receipt.clear();
+            Settings vehicles, vehicle, profile;
+            if (!Settings::singleton().getChild("Vehicles", vehicles) ||
+                !vehicles.getChild(vehicle_setting_->vehicle_name, vehicle) ||
+                !vehicle.hasKey("DynamicsProfile"))
+                return; // Preserve the original GenericQuad model for all other settings.
+
+            const std::string error_prefix = "DynamicsProfile for vehicle '" + vehicle_setting_->vehicle_name + "': ";
+            if (!vehicle.getChild("DynamicsProfile", profile))
+                throw std::invalid_argument(error_prefix + "expected an object");
+
+            try {
+                std::vector<std::string> keys;
+                profile.getChildNames(keys); // Also rejects a nonempty JSON array.
+                const std::vector<std::string> required = { "Schema", "Name", "MassKg", "ThrustToWeightRatio" };
+                for (const auto& key : keys) {
+                    if (std::find(required.begin(), required.end(), key) == required.end())
+                        throw std::invalid_argument("unknown field '" + key + "'");
+                }
+                for (const auto& key : required) {
+                    if (!profile.hasKey(key))
+                        throw std::invalid_argument("missing field '" + key + "'");
+                }
+                if (profile.getDouble("Schema", 0) != 1.0 || profile.getString("Name", "") != "dual_target_v1")
+                    throw std::invalid_argument("expected Schema=1 and Name=dual_target_v1");
+
+                const double mass_kg = profile.getDouble("MassKg", std::numeric_limits<double>::quiet_NaN());
+                const double twr = profile.getDouble("ThrustToWeightRatio", std::numeric_limits<double>::quiet_NaN());
+                // Keep the GenericQuad geometry and its four 55 g motor assemblies.
+                const real_T motor_assembly_mass = 0.055f;
+                if (!std::isfinite(mass_kg) || mass_kg <= 0.055 * params.rotor_count ||
+                    mass_kg > std::numeric_limits<real_T>::max())
+                    throw std::invalid_argument("MassKg must be finite and greater than the total motor mass (0.22 kg)");
+                // The unchanged SimpleFlight velocity controller has a 0.3 throttle floor.
+                // TWR <= 3 leaves its level-hover throttle strictly above that floor.
+                if (!std::isfinite(twr) || twr <= 1.0 || twr > 3.0)
+                    throw std::invalid_argument("ThrustToWeightRatio must be finite and in (1, 3]");
+
+                params.mass = static_cast<real_T>(mass_kg);
+                const real_T box_mass = params.mass - params.rotor_count * motor_assembly_mass;
+                if (!(box_mass > 0))
+                    throw std::invalid_argument("MassKg leaves no positive body mass at simulator precision");
+                computeInertiaMatrix(params.inertia, params.body_box, params.rotor_poses, box_mass, motor_assembly_mass);
+                if (!params.inertia.allFinite() || !(params.inertia.diagonal().array() > 0).all())
+                    throw std::invalid_argument("MassKg produces an invalid inertia matrix");
+
+                // Scale motor speed instead of assigning max_thrust directly: this keeps
+                // calculateMaxThrust() authoritative and preserves the torque/thrust ratio.
+                const real_T gravity = EarthUtils::Gravity;
+                const double target_rotor_thrust = mass_kg * gravity * twr / params.rotor_count;
+                const double max_rpm = params.rotor_params.max_rpm *
+                    std::sqrt(target_rotor_thrust / params.rotor_params.max_thrust);
+                if (!std::isfinite(max_rpm) || max_rpm > std::numeric_limits<real_T>::max())
+                    throw std::invalid_argument("profile produces an invalid motor speed");
+                params.rotor_params.max_rpm = static_cast<real_T>(max_rpm);
+                params.rotor_params.calculateMaxThrust();
+                if (!std::isfinite(params.rotor_params.max_thrust) ||
+                    !std::isfinite(params.rotor_params.max_torque) ||
+                    !std::isfinite(params.rotor_params.max_speed_square) ||
+                    !(params.rotor_params.max_thrust > 0) || !(params.rotor_params.max_torque > 0))
+                    throw std::invalid_argument("profile produces invalid rotor forces");
+
+                const double total_thrust = static_cast<double>(params.rotor_params.max_thrust) * params.rotor_count;
+                const double nominal_twr = total_thrust / (static_cast<double>(params.mass) * gravity);
+                const double min_velocity_throttle = simple_flight::Params().velocity_pid.min_throttle;
+                if (std::abs(nominal_twr - twr) > 1E-5 || 1.0 / nominal_twr <= min_velocity_throttle)
+                    throw std::invalid_argument("computed thrust does not meet the requested profile");
+
+                const nlohmann::json receipt = {
+                    { "schema", 1 }, { "profile", "dual_target_v1" },
+                    { "vehicle", vehicle_setting_->vehicle_name }, { "model", "GenericQuadX" },
+                    { "mass_kg", params.mass }, { "rotor_count", params.rotor_count },
+                    { "max_thrust_per_rotor_n", params.rotor_params.max_thrust },
+                    { "max_torque_per_rotor_nm", params.rotor_params.max_torque },
+                    { "total_max_thrust_n", total_thrust }, { "nominal_twr", nominal_twr },
+                    { "nominal_gravity_mps2", gravity },
+                    { "inertia_diag_kgm2", { params.inertia(0, 0), params.inertia(1, 1), params.inertia(2, 2) } },
+                    { "max_rpm", params.rotor_params.max_rpm },
+                    { "nominal_hover_throttle", 1.0 / nominal_twr },
+                    { "min_velocity_throttle", min_velocity_throttle }
+                };
+                params.dynamics_profile_receipt = receipt.dump();
+            }
+            catch (const std::exception& ex) {
+                throw std::invalid_argument(error_prefix + ex.what());
+            }
+        }
+
         const AirSimSettings::VehicleSetting* vehicle_setting_; //store as pointer because of derived classes
         std::shared_ptr<const SensorFactory> sensor_factory_;
     };
