diff --git a/Unreal/Environments/Blocks/Source/Blocks/DroneControlObserver.cpp b/Unreal/Environments/Blocks/Source/Blocks/DroneControlObserver.cpp
new file mode 100644
index 0000000..700cfa1
--- /dev/null
+++ b/Unreal/Environments/Blocks/Source/Blocks/DroneControlObserver.cpp
@@ -0,0 +1,692 @@
+#include "DroneControlObserver.h"
+
+#include "Camera/CameraComponent.h"
+#include "Camera/PlayerCameraManager.h"
+#include "Components/InputComponent.h"
+#include "Engine/GameViewportClient.h"
+#include "Engine/World.h"
+#include "EngineUtils.h"
+#include "Framework/Application/SlateApplication.h"
+#include "GameFramework/Pawn.h"
+#include "GameFramework/PlayerController.h"
+#include "GameFramework/PlayerStart.h"
+#include "InputCoreTypes.h"
+#include "Styling/CoreStyle.h"
+#include "UnrealClient.h"
+#include "Widgets/Input/SButton.h"
+#include "Widgets/Layout/SBorder.h"
+#include "Widgets/SBoxPanel.h"
+#include "Widgets/SOverlay.h"
+#include "Widgets/Text/STextBlock.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogDroneControlObserver, Log, All);
+
+namespace
+{
+    const FName DroneName(TEXT("DroneControl"));
+    const float MinDistanceCm = 200.f;
+    const float MaxDistanceCm = 50000.f;
+    const float MinCameraHeightCm = 40.f;
+
+    bool FiniteVector(const FVector& Vector)
+    {
+        return FMath::IsFinite(Vector.X) && FMath::IsFinite(Vector.Y) && FMath::IsFinite(Vector.Z);
+    }
+
+    FString JsonVector(const FVector& Vector)
+    {
+        return FString::Printf(TEXT("[%.3f,%.3f,%.3f]"), Vector.X, Vector.Y, Vector.Z);
+    }
+}
+
+ADroneControlObserver::ADroneControlObserver()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    PrimaryActorTick.bStartWithTickEnabled = false;
+    PrimaryActorTick.TickGroup = TG_PostUpdateWork;
+    SetActorEnableCollision(false);
+    Camera = CreateDefaultSubobject<UCameraComponent>(TEXT("ObserverCamera"));
+    RootComponent = Camera;
+    Camera->ProjectionMode = ECameraProjectionMode::Perspective;
+    Camera->FieldOfView = 90.f;
+    Camera->bConstrainAspectRatio = false;
+    Camera->PostProcessBlendWeight = 1.f;
+    Camera->PostProcessSettings.bOverride_AutoExposureMinBrightness = true;
+    Camera->PostProcessSettings.bOverride_AutoExposureMaxBrightness = true;
+    Camera->PostProcessSettings.AutoExposureMinBrightness = 1.f;
+    Camera->PostProcessSettings.AutoExposureMaxBrightness = 1.f;
+    Camera->SetAutoActivate(true);
+}
+
+APlayerController* ADroneControlObserver::FindController()
+{
+    if (!CachedController.IsValid() && GetWorld())
+    {
+        CachedController = GetWorld()->GetFirstPlayerController();
+    }
+    return CachedController.Get();
+}
+
+UGameViewportClient* ADroneControlObserver::FindViewport() const
+{
+    return GetWorld() ? GetWorld()->GetGameViewport() : nullptr;
+}
+
+APawn* ADroneControlObserver::FindDrone()
+{
+    if (CachedDrone.IsValid() && CachedDrone->GetFName() == DroneName)
+    {
+        return CachedDrone.Get();
+    }
+    if (GetWorld())
+    {
+        for (TActorIterator<APawn> It(GetWorld()); It; ++It)
+        {
+            if (It->GetFName() == DroneName)
+            {
+                CachedDrone = *It;
+                return *It;
+            }
+        }
+    }
+    return nullptr;
+}
+
+void ADroneControlObserver::SaveInputState(APlayerController* Controller, UGameViewportClient* Viewport)
+{
+    if (bInputStateSaved || !Controller || !Viewport)
+    {
+        return;
+    }
+    PreviousViewTarget = Controller->GetViewTarget();
+    SavedViewport = Viewport;
+    bPreviousShowCursor = Controller->bShowMouseCursor;
+    bPreviousClickEvents = Controller->bEnableClickEvents;
+    bPreviousMouseOverEvents = Controller->bEnableMouseOverEvents;
+    PreviousCaptureMode = Viewport->GetMouseCaptureMode();
+    bPreviousIgnoreInput = Viewport->IgnoreInput();
+    bPreviousHideCursor = Viewport->HideCursorDuringCapture();
+    // UE4 does not expose the stored lock enum. These queries preserve its
+    // actual windowed-game locking behaviour, including the default mode.
+    PreviousLockMode = Viewport->ShouldAlwaysLockMouse() ? EMouseLockMode::LockAlways
+        : (Viewport->LockDuringCapture() ? EMouseLockMode::LockOnCapture : EMouseLockMode::DoNotLock);
+    if (FSlateApplication::IsInitialized())
+    {
+        PreviousFocusedWidget = FSlateApplication::Get().GetUserFocusedWidget(0);
+    }
+    bInputStateSaved = true;
+}
+
+void ADroneControlObserver::RestoreInputState()
+{
+    APlayerController* Controller = CachedController.Get();
+    UGameViewportClient* Viewport = SavedViewport.Get();
+    if (!bInputStateSaved || !Controller || !Viewport)
+    {
+        bInputStateSaved = false;
+        return;
+    }
+    if (bPreviousIgnoreInput)
+    {
+        FInputModeUIOnly Mode;
+        Mode.SetLockMouseToViewportBehavior(PreviousLockMode);
+        Controller->SetInputMode(Mode);
+    }
+    else if (PreviousCaptureMode == EMouseCaptureMode::CapturePermanently
+        || PreviousCaptureMode == EMouseCaptureMode::CapturePermanently_IncludingInitialMouseDown)
+    {
+        Controller->SetInputMode(FInputModeGameOnly());
+    }
+    else
+    {
+        FInputModeGameAndUI Mode;
+        Mode.SetLockMouseToViewportBehavior(PreviousLockMode);
+        Mode.SetHideCursorDuringCapture(bPreviousHideCursor);
+        Controller->SetInputMode(Mode);
+    }
+    Viewport->SetMouseCaptureMode(PreviousCaptureMode);
+    Viewport->SetMouseLockMode(PreviousLockMode);
+    Viewport->SetHideCursorDuringCapture(bPreviousHideCursor);
+    Viewport->SetIgnoreInput(bPreviousIgnoreInput);
+    Controller->bShowMouseCursor = bPreviousShowCursor;
+    Controller->bEnableClickEvents = bPreviousClickEvents;
+    Controller->bEnableMouseOverEvents = bPreviousMouseOverEvents;
+    if (FSlateApplication::IsInitialized() && PreviousFocusedWidget.IsValid())
+    {
+        FSlateApplication::Get().SetUserFocus(0, PreviousFocusedWidget.Pin());
+    }
+    bInputStateSaved = false;
+    SavedViewport.Reset();
+    PreviousFocusedWidget.Reset();
+}
+
+void ADroneControlObserver::SetEnabled(bool bInEnabled)
+{
+    if (!bInEnabled)
+    {
+        bEnabled = false;
+        SetActorTickEnabled(false);
+        ClearGesture();
+        RemoveToolbar();
+        if (APlayerController* Controller = CachedController.Get())
+        {
+            DisableInput(Controller);
+            if (Controller->GetViewTarget() == this && PreviousViewTarget.IsValid())
+            {
+                Controller->SetViewTarget(PreviousViewTarget.Get());
+            }
+        }
+        RestoreInputState();
+        return;
+    }
+
+    APlayerController* Controller = FindController();
+    UGameViewportClient* Viewport = FindViewport();
+    if (!Controller || !Viewport)
+    {
+        UE_LOG(LogDroneControlObserver, Warning, TEXT("Observer requires a game viewport and local player controller."));
+        return;
+    }
+    SaveInputState(Controller, Viewport);
+    bEnabled = true;
+    SetActorTickEnabled(true);
+    EnableInput(Controller);
+    if (InputComponent && !bWheelBound)
+    {
+        FInputAxisKeyBinding& WheelBinding = InputComponent->BindAxisKey(EKeys::MouseWheelAxis, this, &ADroneControlObserver::OnWheel);
+        WheelBinding.bConsumeInput = false;
+        FInputKeyBinding& DoubleClickBinding = InputComponent->BindKey(EKeys::LeftMouseButton, IE_DoubleClick, this, &ADroneControlObserver::OnDoubleClick);
+        DoubleClickBinding.bConsumeInput = false;
+        bWheelBound = true;
+    }
+    FInputModeGameAndUI Mode;
+    Mode.SetLockMouseToViewportBehavior(EMouseLockMode::DoNotLock);
+    Mode.SetHideCursorDuringCapture(false);
+    Controller->SetInputMode(Mode);
+    Controller->bShowMouseCursor = true;
+    Controller->bEnableClickEvents = false;
+    Controller->bEnableMouseOverEvents = false;
+    ClearGesture();
+    CreateToolbar();
+    if (!bInitializedView)
+    {
+        FocusDrone();
+    }
+    else
+    {
+        TakeView();
+        UpdateCamera();
+    }
+}
+
+void ADroneControlObserver::TakeView()
+{
+    if (bEnabled)
+    {
+        if (APlayerController* Controller = FindController())
+        {
+            Controller->SetViewTarget(this);
+        }
+    }
+}
+
+void ADroneControlObserver::FocusDrone()
+{
+    if (APawn* Drone = FindDrone())
+    {
+        const FVector Location = Drone->GetActorLocation();
+        if (FiniteVector(Location))
+        {
+            Pivot = Location;
+        }
+    }
+    else
+    {
+        Pivot = (FieldMin + FieldMax) * .5f;
+    }
+    YawDegrees = 45.f;
+    ElevationDegrees = 25.f;
+    DistanceCm = 1800.f;
+    bFollow = true;
+    bInitializedView = true;
+    ClearGesture();
+    TakeView();
+    UpdateCamera();
+}
+
+void ADroneControlObserver::SetFollow(bool bInFollow)
+{
+    bFollow = bInFollow;
+    if (bFollow)
+    {
+        if (APawn* Drone = FindDrone())
+        {
+            const FVector Location = Drone->GetActorLocation();
+            if (FiniteVector(Location))
+            {
+                Pivot = Location;
+            }
+        }
+    }
+    TakeView();
+    UpdateCamera();
+}
+
+void ADroneControlObserver::SetFieldBounds(float XMin, float XMax, float YMin, float YMax, float HeightMin, float HeightMax)
+{
+    if (!FMath::IsFinite(XMin) || !FMath::IsFinite(XMax) || !FMath::IsFinite(YMin) || !FMath::IsFinite(YMax)
+        || !FMath::IsFinite(HeightMin) || !FMath::IsFinite(HeightMax)
+        || XMax <= XMin || YMax <= YMin || HeightMax <= HeightMin)
+    {
+        UE_LOG(LogDroneControlObserver, Warning, TEXT("Ignoring invalid observer field bounds."));
+        return;
+    }
+    FVector Origin(0.f, 0.f, 100.f);
+    if (GetWorld())
+    {
+        for (TActorIterator<APlayerStart> It(GetWorld()); It; ++It)
+        {
+            Origin = It->GetActorLocation();
+            break;
+        }
+    }
+    const FVector NewMin = Origin + FVector(XMin * 100.f, YMin * 100.f, HeightMin * 100.f);
+    const FVector NewMax = Origin + FVector(XMax * 100.f, YMax * 100.f, HeightMax * 100.f);
+    if (FiniteVector(NewMin) && FiniteVector(NewMax))
+    {
+        FieldMin = NewMin;
+        FieldMax = NewMax;
+        GroundHeightCm = Origin.Z - 100.f;
+    }
+}
+
+void ADroneControlObserver::ResetOverview()
+{
+    // The scene includes the ground, border and labels outside the flight box.
+    // Expand only the observer's framing volume; the control bounds stay intact.
+    const float ScenePadding = FMath::Max(FieldMax.X - FieldMin.X, FieldMax.Y - FieldMin.Y) * .15f;
+    FVector FrameMin = FieldMin - FVector(ScenePadding, ScenePadding, 0.f);
+    const FVector FrameMax = FieldMax + FVector(ScenePadding, ScenePadding, 0.f);
+    FrameMin.Z = FMath::Min(FrameMin.Z, GroundHeightCm);
+    Pivot = (FrameMin + FrameMax) * .5f;
+    YawDegrees = 45.f;
+    ElevationDegrees = 45.f;
+    bFollow = false;
+    bInitializedView = true;
+    int32 Width = 1280;
+    int32 Height = 720;
+    if (APlayerController* Controller = FindController())
+    {
+        Controller->GetViewportSize(Width, Height);
+    }
+    const float Aspect = Width > 0 && Height > 0 ? float(Width) / float(Height) : 16.f / 9.f;
+    const FRotator Rotation(-ElevationDegrees, YawDegrees, 0.f);
+    const FVector Forward = Rotation.Vector();
+    const FRotationMatrix Matrix(Rotation);
+    const FVector Right = Matrix.GetScaledAxis(EAxis::Y);
+    const FVector Up = Matrix.GetScaledAxis(EAxis::Z);
+    const float TanHorizontal = FMath::Tan(FMath::DegreesToRadians(Camera->FieldOfView * .5f));
+    const float TanVertical = TanHorizontal / Aspect;
+    float RequiredDistance = MinDistanceCm;
+    for (int32 Index = 0; Index < 8; ++Index)
+    {
+        const FVector Corner((Index & 1) ? FrameMax.X : FrameMin.X,
+            (Index & 2) ? FrameMax.Y : FrameMin.Y,
+            (Index & 4) ? FrameMax.Z : FrameMin.Z);
+        const FVector Offset = Corner - Pivot;
+        const float DepthOffset = FVector::DotProduct(Offset, Forward);
+        RequiredDistance = FMath::Max(RequiredDistance,
+            FMath::Abs(FVector::DotProduct(Offset, Right)) / TanHorizontal - DepthOffset);
+        RequiredDistance = FMath::Max(RequiredDistance,
+            FMath::Abs(FVector::DotProduct(Offset, Up)) / TanVertical - DepthOffset);
+    }
+    DistanceCm = FMath::Clamp(RequiredDistance * 1.2f, MinDistanceCm, MaxDistanceCm);
+    ClearGesture();
+    TakeView();
+    UpdateCamera();
+}
+
+void ADroneControlObserver::UpdateCamera()
+{
+    if (!FiniteVector(Pivot) || !FMath::IsFinite(DistanceCm) || !FMath::IsFinite(YawDegrees)
+        || !FMath::IsFinite(ElevationDegrees))
+    {
+        return;
+    }
+    ElevationDegrees = FMath::Clamp(ElevationDegrees, 5.f, 85.f);
+    DistanceCm = FMath::Clamp(DistanceCm, MinDistanceCm, MaxDistanceCm);
+    YawDegrees = FRotator::NormalizeAxis(YawDegrees);
+    const FRotator DesiredRotation(-ElevationDegrees, YawDegrees, 0.f);
+    FVector Location = Pivot - DesiredRotation.Vector() * DistanceCm;
+    Location.Z = FMath::Max(Location.Z, MinCameraHeightCm);
+    const FVector Direction = Pivot - Location;
+    if (FiniteVector(Location) && !Direction.IsNearlyZero())
+    {
+        SetActorLocationAndRotation(Location, Direction.Rotation(), false, nullptr, ETeleportType::TeleportPhysics);
+    }
+}
+
+void ADroneControlObserver::ClearGesture()
+{
+    bMouseValid = false;
+    bOrbitDragging = false;
+    bPanDragging = false;
+    bOrbitCounted = false;
+    bPanCounted = false;
+    PendingWheel = 0.f;
+    if (APlayerController* Controller = CachedController.Get())
+    {
+        bLastLeftDown = Controller->IsInputKeyDown(EKeys::LeftMouseButton);
+        bLastRightDown = Controller->IsInputKeyDown(EKeys::RightMouseButton);
+    }
+    else
+    {
+        bLastLeftDown = false;
+        bLastRightDown = false;
+    }
+}
+
+bool ADroneControlObserver::IsOverToolbar() const
+{
+    return ToolbarPanel.IsValid() && FSlateApplication::IsInitialized()
+        && ToolbarPanel->GetCachedGeometry().IsUnderLocation(FSlateApplication::Get().GetCursorPos());
+}
+
+bool ADroneControlObserver::CanSampleMouse(FVector2D& MousePosition) const
+{
+    APlayerController* Controller = CachedController.Get();
+    UGameViewportClient* Viewport = FindViewport();
+    if (!bEnabled || !Controller || Controller->GetViewTarget() != this || !Viewport || !Viewport->Viewport
+        || !Viewport->Viewport->HasFocus() || !Viewport->Viewport->IsForegroundWindow())
+    {
+        return false;
+    }
+    float X = 0.f;
+    float Y = 0.f;
+    if (!Controller->GetMousePosition(X, Y) || !FMath::IsFinite(X) || !FMath::IsFinite(Y))
+    {
+        return false;
+    }
+    const FIntPoint Size = Viewport->Viewport->GetSizeXY();
+    if (X < 0.f || Y < 0.f || X >= Size.X || Y >= Size.Y)
+    {
+        return false;
+    }
+    MousePosition = FVector2D(X, Y);
+    return true;
+}
+
+void ADroneControlObserver::OnWheel(float Value)
+{
+    FVector2D MousePosition;
+    if (FMath::IsFinite(Value) && Value != 0.f && CanSampleMouse(MousePosition) && !IsOverToolbar())
+    {
+        PendingWheel += Value;
+    }
+}
+
+void ADroneControlObserver::OnDoubleClick()
+{
+    FVector2D MousePosition;
+    if (CanSampleMouse(MousePosition) && !IsOverToolbar() && IsOverDrone(MousePosition))
+    {
+        ++DoubleClickCount;
+        FocusDrone();
+    }
+}
+
+bool ADroneControlObserver::IsOverDrone(const FVector2D& MousePosition)
+{
+    APawn* Drone = FindDrone();
+    APlayerController* Controller = CachedController.Get();
+    if (!Drone || !Controller)
+    {
+        return false;
+    }
+    FVector Centre;
+    FVector Extent;
+    Drone->GetActorBounds(false, Centre, Extent);
+    FVector2D ScreenMin(FLT_MAX, FLT_MAX);
+    FVector2D ScreenMax(-FLT_MAX, -FLT_MAX);
+    bool bProjected = false;
+    for (int32 Index = 0; Index < 8; ++Index)
+    {
+        const FVector Corner = Centre + FVector((Index & 1) ? Extent.X : -Extent.X,
+            (Index & 2) ? Extent.Y : -Extent.Y, (Index & 4) ? Extent.Z : -Extent.Z);
+        FVector2D Screen;
+        if (Controller->ProjectWorldLocationToScreen(Corner, Screen, false))
+        {
+            ScreenMin.X = FMath::Min(ScreenMin.X, Screen.X);
+            ScreenMin.Y = FMath::Min(ScreenMin.Y, Screen.Y);
+            ScreenMax.X = FMath::Max(ScreenMax.X, Screen.X);
+            ScreenMax.Y = FMath::Max(ScreenMax.Y, Screen.Y);
+            bProjected = true;
+        }
+    }
+    return bProjected && MousePosition.X >= ScreenMin.X - 20.f && MousePosition.X <= ScreenMax.X + 20.f
+        && MousePosition.Y >= ScreenMin.Y - 20.f && MousePosition.Y <= ScreenMax.Y + 20.f;
+}
+
+void ADroneControlObserver::Tick(float DeltaSeconds)
+{
+    Super::Tick(DeltaSeconds);
+    APlayerController* Controller = FindController();
+    if (!bEnabled || !Controller || Controller->GetViewTarget() != this)
+    {
+        ClearGesture();
+        return;
+    }
+    if (bFollow)
+    {
+        if (APawn* Drone = FindDrone())
+        {
+            const FVector Location = Drone->GetActorLocation();
+            if (FiniteVector(Location))
+            {
+                Pivot = Location;
+            }
+        }
+    }
+    UpdateCamera();
+    FVector2D MousePosition;
+    if (!FMath::IsFinite(DeltaSeconds) || DeltaSeconds <= 0.f || DeltaSeconds > .25f
+        || !CanSampleMouse(MousePosition) || IsOverToolbar())
+    {
+        ClearGesture();
+        return;
+    }
+    const bool bLeftDown = Controller->IsInputKeyDown(EKeys::LeftMouseButton);
+    const bool bRightDown = Controller->IsInputKeyDown(EKeys::RightMouseButton);
+    if (!bMouseValid)
+    {
+        LastMouse = MousePosition;
+        bMouseValid = true;
+    }
+    if (bLeftDown && !bLastLeftDown)
+    {
+        bOrbitDragging = true;
+        bOrbitCounted = false;
+    }
+    if (bRightDown && !bLastRightDown)
+    {
+        bPanDragging = true;
+        bPanCounted = false;
+    }
+    if (!bLeftDown)
+    {
+        bOrbitDragging = false;
+        bOrbitCounted = false;
+    }
+    if (!bRightDown)
+    {
+        bPanDragging = false;
+        bPanCounted = false;
+    }
+    const FVector2D Delta = MousePosition - LastMouse;
+    const bool bSaneDelta = FMath::IsFinite(Delta.X) && FMath::IsFinite(Delta.Y) && Delta.SizeSquared() < 160000.f;
+    if (bSaneDelta && !Delta.IsNearlyZero())
+    {
+        if (bOrbitDragging && bLeftDown && !bRightDown)
+        {
+            YawDegrees += Delta.X * .3f;
+            ElevationDegrees += Delta.Y * .25f;
+            if (!bOrbitCounted)
+            {
+                ++OrbitGestureCount;
+                bOrbitCounted = true;
+            }
+        }
+        else if (bPanDragging && bRightDown && !bLeftDown)
+        {
+            int32 Width = 0;
+            int32 Height = 0;
+            Controller->GetViewportSize(Width, Height);
+            const float CmPerPixel = 2.f * DistanceCm * FMath::Tan(FMath::DegreesToRadians(Camera->FieldOfView * .5f))
+                / FMath::Max(Width, 1);
+            Pivot += Camera->GetRightVector() * (-Delta.X * CmPerPixel)
+                + Camera->GetUpVector() * (Delta.Y * CmPerPixel);
+            bFollow = false;
+            if (!bPanCounted)
+            {
+                ++PanGestureCount;
+                bPanCounted = true;
+            }
+        }
+    }
+    if (FMath::IsFinite(PendingWheel) && PendingWheel != 0.f)
+    {
+        const float Wheel = FMath::Clamp(PendingWheel, -10.f, 10.f);
+        DistanceCm = FMath::Clamp(DistanceCm * FMath::Exp(-Wheel * .15f), MinDistanceCm, MaxDistanceCm);
+        ++WheelGestureCount;
+    }
+    PendingWheel = 0.f;
+    LastMouse = MousePosition;
+    bLastLeftDown = bLeftDown;
+    bLastRightDown = bRightDown;
+    UpdateCamera();
+}
+
+FText ADroneControlObserver::FollowLabel() const
+{
+    return FText::FromString(bFollow ? TEXT("跟随：开") : TEXT("跟随：关"));
+}
+
+void ADroneControlObserver::CreateToolbar()
+{
+    if (ToolbarOverlay.IsValid())
+    {
+        return;
+    }
+    UGameViewportClient* Viewport = FindViewport();
+    if (!Viewport)
+    {
+        return;
+    }
+    const FSlateFontInfo Font = FCoreStyle::GetDefaultFontStyle("Regular", 12);
+    TSharedRef<SWidget> Panel = SNew(SBorder)
+        .BorderImage(FCoreStyle::Get().GetBrush("WhiteBrush"))
+        .BorderBackgroundColor(FLinearColor(.025f, .035f, .05f, .9f))
+        .Padding(10.f)
+        [
+            SNew(SVerticalBox)
+            + SVerticalBox::Slot().AutoHeight()
+            [
+                SNew(SHorizontalBox)
+                + SHorizontalBox::Slot().AutoWidth().Padding(0.f, 0.f, 6.f, 0.f)
+                [
+                    SNew(SButton).IsFocusable(false).OnClicked_UObject(this, &ADroneControlObserver::OnFocusClicked)
+                    [ SNew(STextBlock).Font(Font).Text(FText::FromString(TEXT("聚焦无人机"))) ]
+                ]
+                + SHorizontalBox::Slot().AutoWidth().Padding(0.f, 0.f, 6.f, 0.f)
+                [
+                    SNew(SButton).IsFocusable(false).OnClicked_UObject(this, &ADroneControlObserver::OnFollowClicked)
+                    [ SNew(STextBlock).Font(Font).Text_UObject(this, &ADroneControlObserver::FollowLabel) ]
+                ]
+                + SHorizontalBox::Slot().AutoWidth()
+                [
+                    SNew(SButton).IsFocusable(false).OnClicked_UObject(this, &ADroneControlObserver::OnOverviewClicked)
+                    [ SNew(STextBlock).Font(Font).Text(FText::FromString(TEXT("整体场景"))) ]
+                ]
+            ]
+            + SVerticalBox::Slot().AutoHeight().Padding(0.f, 8.f, 0.f, 0.f)
+            [
+                SNew(STextBlock).Font(Font).ColorAndOpacity(FLinearColor(.88f, .92f, .97f))
+                    .Text(FText::FromString(TEXT("左拖旋转  ·  右拖平移  ·  滚轮远近  ·  双击无人机聚焦")))
+            ]
+        ];
+    ToolbarPanel = Panel;
+    ToolbarOverlay = SNew(SOverlay).Visibility(EVisibility::SelfHitTestInvisible)
+        + SOverlay::Slot().HAlign(HAlign_Left).VAlign(VAlign_Top).Padding(12.f)
+        [ Panel ];
+    Viewport->AddViewportWidgetContent(ToolbarOverlay.ToSharedRef(), 100);
+}
+
+void ADroneControlObserver::RemoveToolbar()
+{
+    if (ToolbarOverlay.IsValid())
+    {
+        if (UGameViewportClient* Viewport = FindViewport())
+        {
+            Viewport->RemoveViewportWidgetContent(ToolbarOverlay.ToSharedRef());
+        }
+    }
+    ToolbarOverlay.Reset();
+    ToolbarPanel.Reset();
+}
+
+FReply ADroneControlObserver::OnFocusClicked()
+{
+    FocusDrone();
+    return FReply::Handled();
+}
+
+FReply ADroneControlObserver::OnFollowClicked()
+{
+    SetFollow(!bFollow);
+    ClearGesture();
+    return FReply::Handled();
+}
+
+FReply ADroneControlObserver::OnOverviewClicked()
+{
+    ResetOverview();
+    return FReply::Handled();
+}
+
+void ADroneControlObserver::DumpState()
+{
+    APlayerController* Controller = FindController();
+    const AActor* Target = Controller ? Controller->GetViewTarget() : nullptr;
+    FString TargetName = Target ? Target->GetName() : TEXT("");
+    TargetName.ReplaceInline(TEXT("\\"), TEXT("\\\\"));
+    TargetName.ReplaceInline(TEXT("\""), TEXT("\\\""));
+    int32 ViewportWidth = 0;
+    int32 ViewportHeight = 0;
+    if (Controller)
+    {
+        Controller->GetViewportSize(ViewportWidth, ViewportHeight);
+    }
+    APawn* Drone = FindDrone();
+    const FVector DroneLocation = Drone ? Drone->GetActorLocation() : FVector::ZeroVector;
+    FVector2D DroneScreen = FVector2D::ZeroVector;
+    const bool bDroneProjected = Controller && Drone
+        && Controller->ProjectWorldLocationToScreen(DroneLocation, DroneScreen, false);
+    APlayerCameraManager* CameraManager = Controller ? Controller->PlayerCameraManager : nullptr;
+    const FVector ManagerLocation = CameraManager ? CameraManager->GetCameraLocation() : FVector::ZeroVector;
+    const FRotator ManagerRotation = CameraManager ? CameraManager->GetCameraRotation() : FRotator::ZeroRotator;
+    const float ManagerFov = CameraManager ? CameraManager->GetFOVAngle() : 0.f;
+    UE_LOG(LogDroneControlObserver, Display,
+        TEXT("DCO_STATE {\"enabled\":%s,\"follow\":%s,\"pivot\":%s,\"camera\":%s,\"yaw\":%.3f,\"elevation\":%.3f,\"distance\":%.3f,\"left\":%d,\"right\":%d,\"wheel\":%d,\"double\":%d,\"viewtarget\":\"%s\",\"viewport\":[%d,%d],\"drone_world\":%s,\"drone_projected\":%s,\"drone_screen\":[%.3f,%.3f],\"manager_location\":%s,\"manager_rotation\":[%.3f,%.3f,%.3f],\"manager_fov\":%.3f}"),
+        bEnabled ? TEXT("true") : TEXT("false"), bFollow ? TEXT("true") : TEXT("false"),
+        *JsonVector(Pivot), *JsonVector(GetActorLocation()), YawDegrees, ElevationDegrees, DistanceCm,
+        OrbitGestureCount, PanGestureCount, WheelGestureCount, DoubleClickCount, *TargetName,
+        ViewportWidth, ViewportHeight, *JsonVector(DroneLocation), bDroneProjected ? TEXT("true") : TEXT("false"),
+        DroneScreen.X, DroneScreen.Y, *JsonVector(ManagerLocation), ManagerRotation.Pitch, ManagerRotation.Yaw,
+        ManagerRotation.Roll, ManagerFov);
+}
+
+void ADroneControlObserver::EndPlay(const EEndPlayReason::Type EndPlayReason)
+{
+    SetEnabled(false);
+    Super::EndPlay(EndPlayReason);
+}
